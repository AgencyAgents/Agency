{
  "name": "agency",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "scripts": {
    "build": "bun run --filter='*' build",
    "test": "bun test",
    "typecheck": "bun x tsc --build tsconfig.json",
    "typecheck:test": "bun x tsc --build tsconfig.test.json",
    "lint": "bun x biome check .",
    "lint:fix": "bun x biome check --write ."
  },
  "dependencies": {
    "fuzzysort": "^4.0.2"
  }
}
